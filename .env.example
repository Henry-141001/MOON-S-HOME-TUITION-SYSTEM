# Copy to .env and fill in from Neon dashboard → Connect.
# Pooled connection (hostname contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler") — used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Initial admin account — used once by `npm run db:seed`.
# Change the password in the app (Tetapan) after your first login.
ADMIN_ID="MOON"
ADMIN_NAME="Cikgu Moon"
ADMIN_PASSWORD="choose-a-strong-password-10-chars"
