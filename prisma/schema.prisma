// Moons Home Tutor System — database schema
// Two roles only: ADMIN (the teacher) and PARENT.
// After changing models, run: npm run db:migrate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  PARENT
  SUPER_ADMIN // Pemerhati: read-only observer of all admin and parent data
}

enum AttendanceStatus {
  PRESENT // Hadir
  ABSENT // Tidak Hadir
  EXCUSED // Bersebab
}

enum SchoolExamType {
  MONTHLY_TEST // Ujian Bulanan
  MID_YEAR // Peperiksaan Pertengahan Tahun
  FINAL // Peperiksaan Akhir Tahun
  UASA // UASA
  OTHER // Lain-lain
}

enum SubmissionStatus {
  PENDING // Menunggu Semakan
  APPROVED // Diluluskan
  NEEDS_CORRECTION // Perlu Pembetulan
}

enum CommentCategory {
  ACADEMIC // Prestasi Akademik
  STRENGTHS // Kekuatan
  IMPROVEMENT // Ruang Penambahbaikan
  PARTICIPATION // Penyertaan Dalam Kelas
  HOMEWORK // Kerja Rumah
  ATTITUDE // Sikap dan Disiplin
  RECOMMENDATIONS // Cadangan untuk Ibu Bapa
  GENERAL // Ulasan Umum
  EXAM_RESULT // Keputusan Ujian (linked to one tuition test)
}

enum ReplyAuthor {
  ADMIN
  PARENT
}

// ───────────────────────── Accounts ─────────────────────────

/// The single admin/teacher account.
model Admin {
  id           String   @id @default(cuid())
  loginId      String   @unique /// Admin ID used to log in (no email)
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  attendance        Attendance[]
  tuitionExams      TuitionExamination[]
  comments          TeacherComment[]
  reviewedSchoolExs SchoolExamination[]
  commentReplies    CommentReply[]

  @@map("admin")
}

/// One row per family. Parents log in with parentCode only (optional PIN).
model Parent {
  id         String   @id @default(cuid())
  parentCode String   @unique /// e.g. MHT001-K7QX — the Parent ID
  name       String /// Parent / guardian name
  phone      String?
  notes      String?
  pinHash    String? /// Optional PIN upgrade — when set, login also asks for the PIN
  isActive   Boolean  @default(true)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  children    ParentStudent[]
  sessions    Session[]
  submissions SchoolExamination[]
  replies     CommentReply[]

  @@map("parents")
}

/// Read-only observer ("Pemerhati"). Logs in through the Parent ID field with
/// a long, random access code. Cannot change any data. Not visible to the admin.
model SuperAdmin {
  id         String   @id @default(cuid())
  accessCode String   @unique /// e.g. SA-K7QX-M2PA-9RTD
  name       String
  pinHash    String? /// optional extra PIN, same flow as parents
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions Session[]

  @@map("super_admins")
}

// ───────────────────────── Students ─────────────────────────

model Student {
  id               String   @id @default(cuid())
  studentCode      String   @unique /// e.g. STU001 — the Student ID
  fullName         String
  school           String
  yearForm         String /// e.g. "Tahun 5", "Tingkatan 2"
  guardianName     String
  registrationDate DateTime @db.Date
  isActive         Boolean  @default(true)
  isDemo           Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  photo          StudentPhoto?
  subjects       StudentSubject[]
  parents        ParentStudent[]
  attendance     Attendance[]
  tuitionResults TuitionResult[]
  comments       TeacherComment[]
  schoolExams    SchoolExamination[]

  @@map("students")
}

/// Photos are stored privately in the database (small, resized JPEGs)
/// and served only to the admin or the student's own parent.
model StudentPhoto {
  studentId String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_photos")
}

/// One Parent ID can be linked to many children (siblings).
model ParentStudent {
  parentId     String
  studentId    String
  relationship String? /// e.g. Ibu, Bapa, Penjaga
  createdAt    DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
  @@map("parent_students")
}

// ───────────────────────── Subjects ─────────────────────────

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  students      StudentSubject[]
  tuitionExams  TuitionExamination[]
  schoolResults SchoolResult[]
  sessions      TuitionSessionSubject[]

  @@map("subjects")
}

/// Subjects a student is enrolled in at the tuition centre.
model StudentSubject {
  studentId String
  subjectId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([studentId, subjectId])
  @@map("student_subjects")
}

// ───────────────────────── Attendance ─────────────────────────

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy Admin   @relation(fields: [recordedById], references: [id])

  @@unique([studentId, date]) /// one record per student per day
  @@index([date])
  @@map("attendance")
}

/// Planned tuition classes, shown as "upcoming sessions" on the dashboard.
model TuitionSession {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String /// "15:00"
  endTime   String /// "17:00"
  title     String
  notes     String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  /// Subjects this class covers (one class can mix groups, e.g. Matematik + 3M).
  /// No subjects = a general class for every student.
  subjects TuitionSessionSubject[]

  @@index([date])
  @@map("tuition_sessions")
}

model TuitionSessionSubject {
  sessionId String
  subjectId String

  session TuitionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([sessionId, subjectId])
  @@index([subjectId])
  @@map("tuition_session_subjects")
}

// ───────────────────────── Tuition exams (admin only) ─────────────────────────

model TuitionExamination {
  id          String   @id @default(cuid())
  name        String /// e.g. "Ujian Topikal 1"
  subjectId   String
  date        DateTime @db.Date
  totalMarks  Float
  remarks     String?
  isDemo      Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy Admin            @relation(fields: [createdById], references: [id])
  results   TuitionResult[]
  comments  TeacherComment[]

  @@index([date])
  @@map("tuition_examinations")
}

model TuitionResult {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  marksObtained Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    TuitionExamination @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId]) /// one mark per student per test
  @@index([studentId])
  @@map("tuition_results")
}

// ───────────────────────── Teacher comments ─────────────────────────

model TeacherComment {
  id            String          @id @default(cuid())
  studentId     String
  category      CommentCategory
  content       String
  commentDate   DateTime        @db.Date
  isPublished   Boolean         @default(true) /// parents only see published comments
  /// Optional tuition test this comment is about (shown next to that test's mark).
  tuitionExamId String?
  authorId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author      Admin               @relation(fields: [authorId], references: [id])
  tuitionExam TuitionExamination? @relation(fields: [tuitionExamId], references: [id], onDelete: SetNull)
  replies     CommentReply[]

  @@index([studentId, commentDate])
  @@index([tuitionExamId])
  @@map("teacher_comments")
}

/// A message in the conversation under a teacher comment (teacher or parent).
model CommentReply {
  id         String      @id @default(cuid())
  commentId  String
  authorType ReplyAuthor
  adminId    String?
  parentId   String?
  content    String
  /// When the other side (teacher for parent replies, parent for teacher replies) first saw it.
  readAt     DateTime?
  createdAt  DateTime    @default(now())

  comment TeacherComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  admin   Admin?         @relation(fields: [adminId], references: [id], onDelete: SetNull)
  parent  Parent?        @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@index([commentId, createdAt])
  @@index([authorType, readAt])
  @@map("comment_replies")
}

// ───────────────────────── School exams (parent input) ─────────────────────────

model SchoolExamination {
  id            String           @id @default(cuid())
  studentId     String
  submittedById String?
  examType      SchoolExamType
  examName      String           @default("") /// optional label, e.g. "Ujian Bulan Mac"
  examDate      DateTime         @db.Date
  remarks       String?
  status        SubmissionStatus @default(PENDING)
  adminNote     String? /// shown to parent, e.g. what needs correcting
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedBy Parent?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  Admin?         @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  results     SchoolResult[]

  @@unique([studentId, examType, examName, examDate]) /// no duplicate submissions
  @@index([status])
  @@map("school_examinations")
}

model SchoolResult {
  id            String @id @default(cuid())
  examId        String
  subjectId     String
  marksObtained Float
  totalMarks    Float

  exam    SchoolExamination @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([examId, subjectId]) /// one mark per subject per exam
  @@map("school_results")
}

// ───────────────────────── Security & settings ─────────────────────────

/// Server-side login sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  role            Role
  adminId         String?
  parentId        String?
  superAdminId    String?
  /// Super admin only: the parent whose portal is being viewed (read-only).
  observeParentId String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  admin      Admin?      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  parent     Parent?     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

/// Used to rate-limit login attempts (brute-force protection for Parent IDs).
model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  kind      Role
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, kind, createdAt])
  @@map("login_attempts")
}

/// Audit trail of logins and every change made by the admin and parents.
/// Shown only to the super admin.
model ActivityLog {
  id        String   @id @default(cuid())
  actorRole Role? /// null = unknown visitor (failed login)
  actorId   String?
  actorName String
  action    String /// machine key, e.g. "attendance.save"
  summary   String /// human-readable Malay description
  studentId String? /// related student, if any (no FK so history survives deletes)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorRole, createdAt])
  @@map("activity_logs")
}

/// Single-row table for tuition centre details used on reports.
model AppSetting {
  id         Int      @id @default(1)
  centreName String   @default("Moons Home Tutor")
  phone      String?
  address    String?
  reportNote String?
  updatedAt  DateTime @updatedAt

  @@map("app_settings")
}
